# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Supabase ---
# Project URL and the PUBLIC anon key, both from Settings > API in the dashboard.
# The service-role key is intentionally NOT used anywhere: all data access goes
# through the anon key + the user's own JWT so Postgres RLS applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=          # only if your project uses legacy HS256 JWT secret; leave empty to use JWKS

# --- LLM provider toggle: "ollama" (local) or "openrouter" (cloud) ---
# This single line is the only change needed to switch providers.
LLM_PROVIDER=ollama

# Ollama (local, private)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenRouter (cloud)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Optional attribution headers OpenRouter shows on its dashboard (defaults shown)
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_TITLE=AI Journal

# --- Embeddings (independent of the chat provider above) ---
EMBEDDING_PROVIDER=fastembed       # fastembed | openai_compatible
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                  # must match vector(N) in supabase/schema.sql
EMBEDDING_BASE_URL=                # only for openai_compatible, e.g. http://localhost:11434/v1
EMBEDDING_API_KEY=

# --- RAG tuning ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
LOG_LEVEL=INFO

# --- Isolation test only (backend/tests/test_isolation.py) ---
# Two confirmed test accounts. The test skips itself if these are unset.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
